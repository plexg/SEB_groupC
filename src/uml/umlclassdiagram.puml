@startuml

package classes.nonrooms {
    class Game {
        - player : Player
        - rooms : List<Room>
        - database : Database
        - items : List<Item>
        + startGame(sc : Scanner)
        + continueGame(sc : Scanner)
        + newGame(sc : Scanner)
        + handleStartRoom(sc : Scanner)
        + handleSprintPlanningRoom(sc : Scanner)
        + handleDailyScrumRoom(sc : Scanner)
        + handleScrumBoardRoom(sc : Scanner)
        + handleSprintReviewRoom(sc : Scanner)
        + handleSprintRetrospectiveRoom(sc : Scanner)
        + handleFinalRoom(sc : Scanner)
        + saveAndQuit()
        + goBack(sc : Scanner)
        + useItem(item : Healer, itemName : String, sc : Scanner)
        + useHintJoker(sc : Scanner)
        + useKeyJoker(sc : Scanner)
        + getPreviousRoomName() : String
    }

    class Player implements Subject {
        - observers : List<Observer>
        - hp : int
        - name : String
        - inventory : Inventory
        - room : Room
        - previousRoom : Room
        + addObserver(observer : Observer)
        + removeObserver(observer : Observer)
        + notifyObservers()
        + setHp(hp : int)
        + getHp() : int
        + setRoom(room : Room)
        + getRoom() : Room
        + setPreviousRoom(room : Room)
        + getPreviousRoom() : Room
        + getStatus() : String
        + addItem(item : Item)
        + getInventory() : Inventory
        + setIsKeyUsed(used : boolean)
        + isKeyUsed() : boolean
        + getName() : String
        + getId() : int
    }
}

package classes.observer {
    interface Observer {
        + update(player : Player)
    }
    interface Subject {
        + addObserver(observer : Observer)
        + removeObserver(observer : Observer)
        + notifyObservers()
    }
    class ConsoleLogger implements Observer {
        + update(player : Player)
    }
}

package classes.rooms {
    abstract class Room {
        - name : String
        - player : Player
        + setName(name : String)
        + getName() : String
        + searchRoom()
        + presentChallenge()
        + giveFeedback()
        + showIntroduction()
    }
    class StartRoom extends Room
    class SprintPlanningRoom extends Room
    class DailyScrumRoom extends Room
    class ScrumBoardRoom extends Room
    class SprintReviewRoom extends Room
    class SprintRetrospectiveRoom extends Room
    class FinalRoom extends Room
}

package classes.items {
    abstract class Item {
        + getName() : String
    }
    class CupOfCoffee extends Item
    class Donut extends Item
    class Healer extends Item {
        + heal(player : Player)
    }
    class Inventory {
        + hasItem(name : String, playerId : int, conn : Connection) : boolean
        + removeItem(name : String, playerId : int, conn : Connection)
        + saveToDatabase(playerId : int, conn : Connection)
    }
}

package classes.joker {
    abstract class Joker extends Item {
        + useIn(room : Room)
    }
    class HintJoker extends Joker
    class KeyJoker extends Joker
}

package classes.database {
    class Database {
        + loadPlayer(name : String, game : Game) : Player
        + savePlayer(player : Player) : boolean
        + updatePlayer(player : Player)
        + updatePlayerRoom(name : String, roomName : String)
        + getPlayerRoom(name : String) : String
        + isRoomCompleted(name : String, roomFlag : String) : boolean
        + getConnection() : Connection
    }
}

package Challenge {
    class CategorizationChallenge
    class MultipleChoiceChallenge
}

Game --> Player
Game --> Database
Game --> Room
Game --> Item
Player --> Room
Player --> Inventory
Player --> Observer
Player ..|> Subject
ConsoleLogger ..|> Observer
Room <|-- StartRoom
Room <|-- SprintPlanningRoom
Room <|-- DailyScrumRoom
Room <|-- ScrumBoardRoom
Room <|-- SprintReviewRoom
Room <|-- SprintRetrospectiveRoom
Room <|-- FinalRoom
Item <|-- CupOfCoffee
Item <|-- Donut
Item <|-- Healer
Item <|-- Joker
Joker <|-- HintJoker
Joker <|-- KeyJoker

@enduml